      "desc",
      "namedview",
      "RDF",
      "Work",
      "format",
      "type"
    ],
    "attributes": [
      "version",
      "xmlns",
      "aria-label",
      "role",
      "data-name"
    ],
    "$comment": "Present in ordinary tool output and carrying no drawing instruction. Skipped in silence \u2014 warning about these would bury the warnings that matter under noise from every file Inkscape has ever written."
  }
