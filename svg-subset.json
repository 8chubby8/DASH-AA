  "excluded": {
    "elements": {
      "text": {
        "reason": "Compose's vector model has no text element, so there is nowhere for it to land.",
        "advice": "Convert it to a path before exporting (Inkscape: Path > Object to Path). Text that never changes is artwork; text that changes needs a text layer in the layout."
      },
      "tspan": {
        "reason": "Part of a text element.",
        "advice": "See text."
      },
      "image": {
        "reason": "A raster inside vector artwork. DASH loads rasters as their own layer, where they can be positioned and bound.",
        "advice": "Ship the image as its own asset and add a raster layer."
      },
      "use": {
        "reason": "An instanced reference. Two copies of one element cannot both carry the id a binding points at.",
        "advice": "Unlink the clone before exporting (Inkscape: Edit > Clone > Unlink)."
      },
      "symbol": {
        "reason": "Only useful with use.",
        "advice": "See use."
      },
      "filter": {
        "reason": "An image-processing pipeline. DASH draws the element unfiltered.",
        "advice": "Bake the effect into the artwork at export \u2014 a drop shadow drawn as shapes is still a drop shadow."
      },
      "mask": {
        "reason": "Compositing DASH does not implement.",
        "advice": "Flatten it into the artwork at export."
      },
      "clipPath": {
        "reason": "Compositing DASH does not implement. Proportional fill is a reveal binding, which is a clip DASH performs itself.",
        "advice": "Flatten it, or use a reveal binding if it was a fill."
      },
      "pattern": {
        "reason": "A repeating paint server.",
        "advice": "Export the tiled result as a raster asset."
      },
      "marker": {
        "reason": "Arrowheads generated at draw time.",
        "advice": "Convert the stroke and its markers to paths."
      },
      "style": {
        "reason": "A stylesheet needs a CSS engine. The style ATTRIBUTE is parsed; the style ELEMENT is not.",
        "advice": "Save as Plain SVG, or set Inkscape's SVG output to write style attributes rather than a stylesheet."
      },
      "foreignObject": {
        "reason": "Embeds arbitrary HTML. That is a browser.",
        "advice": "Redraw it as vector artwork."
      },
      "script": {
        "reason": "DASH never executes anything a module sends.",
        "advice": "Behaviour belongs in the module's firmware and its bindings."
      },
      "animate": {
        "reason": "SMIL animation. DASH animates through bindings and transitions, which are driven by real module data.",
        "advice": "Express the movement as a binding (module-layout.md \u00a74)."
      },
      "animateTransform": {
        "reason": "SMIL animation.",
        "advice": "Use a rotate or translate binding."
      },
      "animateMotion": {
        "reason": "SMIL animation.",
        "advice": "Use a translate binding."
      },
      "set": {
        "reason": "SMIL animation.",
        "advice": "Use a style binding."
      }
    },
    "attributes": {
      "class": {
        "reason": "CSS selectors need a stylesheet engine.",
        "advice": "Presentation goes in a style attribute or as attributes."
      },
      "filter": {
        "reason": "References an excluded filter. The element draws unfiltered.",
        "advice": "Bake the effect into the artwork at export."
      },
      "mask": {
        "reason": "References an excluded mask.",
        "advice": "Flatten it at export."
      },
      "clip-path": {
        "reason": "References an excluded clipPath.",
        "advice": "Flatten it, or use a reveal binding."
      },
      "stroke-dasharray": {
        "reason": "Not implemented. The stroke draws solid.",
        "advice": "Convert the dashed stroke to paths at export."
      },
      "font-family": {
        "reason": "Only meaningful on text, which is excluded.",
        "advice": "Convert text to paths."
      }
    }
  },
  "ignored": {
    "namespaces": [
