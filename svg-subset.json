  "$comment": "The authoritative SVG subset DASH renders. Read by the DASH parser and by panel-preview \u2014 never hand-maintained in two places. Prose form: module-layout.md \u00a79. Provisional; locks with module-layout.md at roadmap 1.6.10.",
  "version": 1,
  "elements": {
    "svg": {
      "requires": [
        "viewBox"
      ],
      "geometry": [
        "viewBox",
        "width",
        "height"
      ]
    },
    "g": {
      "geometry": []
    },
    "defs": {
      "geometry": []
    },
    "path": {
      "requires": [
        "d"
      ],
      "geometry": [
        "d"
      ]
    },
    "rect": {
      "requires": [
        "width",
        "height"
      ],
      "geometry": [
        "x",
        "y",
        "width",
        "height",
        "rx",
        "ry"
      ]
    },
    "circle": {
      "requires": [
        "r"
      ],
      "geometry": [
        "cx",
        "cy",
        "r"
      ]
    },
    "ellipse": {
      "requires": [
        "rx",
        "ry"
      ],
      "geometry": [
        "cx",
        "cy",
        "rx",
        "ry"
      ]
    },
    "line": {
      "geometry": [
        "x1",
        "y1",
        "x2",
        "y2"
      ]
    },
    "polygon": {
      "requires": [
        "points"
      ],
      "geometry": [
        "points"
      ]
    },
    "polyline": {
      "requires": [
        "points"
      ],
      "geometry": [
        "points"
      ]
    },
    "linearGradient": {
      "geometry": [
        "x1",
        "y1",
        "x2",
        "y2",
        "gradientUnits",
        "gradientTransform",
        "spreadMethod",
        "href"
      ]
    },
    "radialGradient": {
      "geometry": [
        "cx",
        "cy",
        "r",
        "fx",
        "fy",
        "gradientUnits",
        "gradientTransform",
        "spreadMethod",
        "href"
      ]
    },
    "stop": {
      "geometry": [
        "offset"
      ],
      "properties": [
        "stop-color",
        "stop-opacity"
      ]
    }
  },
  "attributes": {
    "global": [
      "id",
      "transform"
    ],
    "presentation": [
      "fill",
      "fill-opacity",
      "fill-rule",
      "stroke",
      "stroke-opacity",
      "stroke-width",
      "stroke-linecap",
      "stroke-linejoin",
      "opacity"
    ],
    "style": {
      "parsed": true,
      "properties": [
        "fill",
        "fill-opacity",
        "fill-rule",
        "stroke",
        "stroke-opacity",
        "stroke-width",
        "stroke-linecap",
        "stroke-linejoin",
        "opacity",
        "stop-color",
        "stop-opacity"
      ],
      "$comment": "The style ATTRIBUTE only \u2014 a semicolon-separated list of the same properties. Not CSS: the <style> element and class are excluded."
    }
  },
  "transforms": [
    "matrix",
    "translate",
    "scale",
    "rotate",
    "skewX",
    "skewY"
  ],
